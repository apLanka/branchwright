      "git commit -n *": "deny",
      "git commit --amend*": "deny",
      "git commit * --amend*": "deny",
      "git add -A*": "deny",
      "git add --all*": "deny",
      "git add .": "deny",
      "git add . *": "deny",
      "git rebase*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "gh issue develop*": "deny",
      "gh pr merge*": "deny",
      "gh pr close*": "deny",
      "gh issue close*": "deny",
      "gh repo delete*": "deny"
    }
  }
