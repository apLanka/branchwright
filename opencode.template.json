{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "/ABSOLUTE/PATH/TO/branchwright"
  ],
  "permission": {
    "skill": {
      "to-tickets": "deny",
      "wayfinder": "deny",
      "research": "deny",
      "prototype": "deny",
      "architect": "deny",
      "codebase-design": "deny",
      "blast-radius": "deny",
      "create-verification-skill": "deny",
      "retro": "deny",
      "reflect": "deny",
      "writing-for-agents": "deny",
      "show-me-your-work": "deny",
      "security-and-hardening": "deny",
      "performance-optimization": "deny",
      "api-and-interface-design": "deny",
      "ci-cd-and-automation": "deny",
      "shipping-and-launch": "deny"
