#!/usr/bin/env bash
# Begin one task of an inline plan run in one call: write the task brief and
# record BASE, the commit the task's review range starts from.
#
# Usage: task-start PLAN_FILE TASK_NUMBER
# Prints: "brief: <path>" and "base: <sha>"
set -euo pipefail
[ $# -eq 2 ] || { echo "usage: task-start PLAN_FILE TASK_NUMBER" >&2; exit 2; }
sdd="$(cd "$(dirname "$0")/../../subagent-driven-development/scripts" && pwd)"
out=$("$sdd/task-brief" "$1" "$2")
brief=$(printf '%s\n' "$out" | sed -n 's/^wrote \(.*\): [0-9][0-9]* lines$/\1/p')
[ -n "$brief" ] || { echo "task-brief did not report a path: $out" >&2; exit 1; }
echo "brief: $brief"
echo "base: $(git rev-parse HEAD)"
